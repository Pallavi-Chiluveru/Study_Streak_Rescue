PORT=5000
MONGODB_URI=mongodb://localhost:27017/studystreakrescue
# Set a cryptographically random secret before starting the API.
JWT_SECRET=
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
