PORT=5000
MONGODB_URI=mongodb://localhost:27017/studystreakrescue
# Set a cryptographically random secret before starting the API.
JWT_SECRET=
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Backend-only email settings. CLIENT_URL must be the HTTPS frontend origin in production.
CLIENT_URL=
# Optional comma-separated CORS allowlist. Local Vite origins are allowed automatically outside production.
CLIENT_URLS=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
# Gmail: enable 2-Step Verification and use a new App Password for EMAIL_PASS.
# SMTP variables belong in the backend host (for example Render), never VITE_* variables.
