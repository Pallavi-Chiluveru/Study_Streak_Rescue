PORT=5000
MONGODB_URI=mongodb://localhost:27017/studystreakrescue
# Set a cryptographically random secret before starting the API.
JWT_SECRET=
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Backend-only email settings. CLIENT_URL must be the HTTPS frontend origin in production.
CLIENT_URL=
# Optional comma-separated CORS allowlist. Local Vite origins are allowed automatically outside production.
CLIENT_URLS=
RESEND_API_KEY=
# Use onboarding@resend.dev for restricted local testing, then a sender on your verified domain in production.
EMAIL_FROM=Study Streak Rescue <onboarding@resend.dev>
# Optional recipient used by npm run test:email. Defaults to EMAIL_FROM when omitted.
EMAIL_TEST_TO=
# The Resend API key belongs in the backend host (for example Render), never a VITE_* variable.
